# Public site settings
PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-permanent-invite
PUBLIC_SITE_URL=https://your-project.vercel.app

# Private Control Center settings
# Choose a strong password for /control-center.
DEAL_DESK_PASSWORD=replace-with-a-long-private-password
# Optional separate signing secret. If omitted, the password signs Control Center sessions.
DEAL_DESK_SESSION_SECRET=replace-with-a-random-long-secret
# Fine-grained GitHub token with Contents: Read and write for this repository only.
GITHUB_TOKEN=github_pat_replace_me

# Private Whop importer settings
WHOP_CLIENT_ID=app_replace_me
# Use a separate high-entropy secret to encrypt Whop access and refresh tokens.
WHOP_TOKEN_SECRET=replace-with-a-different-random-long-secret
# Register this exact callback URL in the Whop app. Replace the domain with production.
WHOP_REDIRECT_URI=https://your-domain.com/api/whop-oauth-callback
# Optional override. The importer needs only user identity and forum read access.
WHOP_OAUTH_SCOPES=openid profile email forum:read

# Optional. Vercel normally supplies the repository owner/name automatically.
GITHUB_REPO_OWNER=UglyGameFace
GITHUB_REPO_NAME=Hidden-files
GITHUB_BRANCH=main

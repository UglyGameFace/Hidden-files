---
import '../styles/whop-importer.css';
---

<section class="whop-importer" data-whop-importer>
  <header class="whop-importer-head">
    <div>
      <span class="desk-kicker">Authorized post transfer</span>
      <h3>Import from Whop</h3>
      <p>Connect through Whop, approve a group, review each post, then add approved posts as hidden SniperPlug drafts.</p>
    </div>
    <div class="whop-connection" data-whop-connection data-state="checking" role="status" aria-live="polite">
      <span aria-hidden="true"></span>
      <div><strong data-whop-connection-title>Checking Whop</strong><small data-whop-connection-detail>No password is shared with SniperPlug.</small></div>
    </div>
  </header>

  <div class="whop-connect-actions">
    <a class="desk-button desk-button-primary" href="/api/whop-oauth-start" data-whop-connect>Continue with Whop</a>
    <button type="button" data-whop-disconnect hidden>Disconnect Whop</button>
  </div>

  <div class="whop-default-sources" data-whop-source-options hidden>
    <span>Default groups</span>
    <div data-whop-source-option-list></div>
    <small>Black Box and Hidden Files are the defaults. Another group can be approved later by scanning its experience ID.</small>
  </div>

  <form class="whop-scan-form" data-whop-scan-form hidden>
    <label class="desk-field desk-field-wide">
      <span>Whop group experience ID or link</span>
      <input name="source" placeholder="exp_xxxxxxxxxxxxxx or a link containing it" autocomplete="off" required />
      <small>Paste the group’s <code>exp_...</code> experience ID. Unapproved groups stop at the approval screen before any posts are loaded.</small>
    </label>
    <button type="submit" class="desk-button desk-button-primary" data-whop-scan>Check group</button>
  </form>

  <div class="whop-scan-status" data-whop-scan-status role="status" aria-live="polite" hidden></div>

  <section class="whop-source-review" data-whop-source-review hidden>
    <div>
      <span class="desk-kicker">Group permission</span>
      <h3 data-whop-source-title>Whop group</h3>
      <p data-whop-source-detail>Approve this exact group before scanning its posts.</p>
    </div>
    <strong class="whop-decision-badge" data-whop-source-state data-state="pending">Needs decision</strong>
    <div class="whop-decision-actions">
      <button type="button" class="whop-approve" data-whop-source-approve>Approve group</button>
      <button type="button" class="whop-disapprove" data-whop-source-disapprove>Disapprove group</button>
    </div>
  </section>

  <section class="whop-review" data-whop-review hidden>
    <header>
      <div><span class="desk-kicker">Post review</span><h3 data-whop-experience-title>Whop posts</h3><p data-whop-scan-summary></p></div>
      <div class="whop-selection-actions">
        <button type="button" class="whop-approve" data-whop-approve-ready>Approve all ready</button>
        <button type="button" class="whop-disapprove" data-whop-disapprove-all>Disapprove all</button>
        <button type="button" data-whop-reset-decisions>Reset choices</button>
      </div>
    </header>

    <div class="whop-import-settings">
      <label class="desk-field"><span>SniperPlug category</span><select data-whop-category required></select></label>
      <label class="whop-rights-confirm"><input type="checkbox" data-whop-rights /> <span>I own these posts or have explicit permission to republish them on SniperPlug.</span></label>
    </div>

    <div class="whop-decision-summary" aria-live="polite">
      <span><strong data-whop-approved-count>0</strong> approved</span>
      <span><strong data-whop-disapproved-count>0</strong> disapproved</span>
      <span><strong data-whop-pending-count>0</strong> need a decision</span>
      <span><strong data-whop-blocked-count>0</strong> blocked</span>
    </div>

    <div class="whop-guide-list" data-whop-guide-list></div>
    <div class="whop-empty" data-whop-empty hidden><strong>No importable posts found</strong><p>Check the experience ID and your Whop permissions.</p></div>

    <footer>
      <p><strong data-whop-selected-count>0 approved for import</strong><span>Everything imports as a hidden draft. Nothing becomes public automatically.</span></p>
      <button type="button" class="desk-button desk-button-primary" data-whop-import disabled>Import approved drafts</button>
    </footer>
  </section>

  <div class="desk-modal-backdrop whop-preview-backdrop" data-whop-preview-backdrop aria-hidden="true" hidden>
    <section class="whop-preview" role="dialog" aria-modal="true" aria-labelledby="whop-preview-title">
      <header><div><span class="desk-kicker">Exact source preview</span><h2 id="whop-preview-title" data-whop-preview-title>Post preview</h2></div><button type="button" data-whop-preview-close aria-label="Close preview">×</button></header>
      <div class="whop-preview-meta" data-whop-preview-meta></div>
      <pre data-whop-preview-body></pre>
      <footer><button type="button" data-whop-preview-close>Close preview</button></footer>
    </section>
  </div>
</section>

<script>
  import '../scripts/whop-importer.js';
</script>
